{
  "name": "friends-and-fables-desktop",
  "productName": "Friends & Fables Desktop",
  "version": "0.5.2",
  "description": "Unofficial Friends & Fables desktop wrapper for Windows and Arch Linux",
  "private": true,
  "main": "dist/main.js",
  "author": "buifgin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buifgin/friends-and-fables-desktop.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:appearance && npm run test:translation && npm run test:panel && npm run test:map && npm run test:commands && npm run test:music && npm run test:instructions",
    "prestart": "npm run build",
    "start": "electron-forge start",
    "prepackage": "npm run build && node scripts/prepare-windows-translator.cjs --if-windows",
    "package": "electron-forge package",
    "premake": "npm run build && node scripts/prepare-windows-translator.cjs --if-windows",
    "make": "electron-forge make",
    "dist:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux AppImage --x64 --publish never",
    "dist:windows": "npm run prepare:translator:windows && npm run build && electron-builder --config electron-builder.config.cjs --win portable --x64 --publish never",
    "checksums": "node scripts/release-checksums.cjs",
    "test:unit": "node --test tests/translation/translation-core.test.cjs tests/translation/bundled-translator.test.cjs tests/music/music-settings.test.cjs tests/music/music-library.test.cjs tests/music/music-catalog.test.cjs tests/commands/host-instructions-core.test.cjs tests/shell/build-resources.test.cjs",
    "test:appearance": "node scripts/run-electron-test.cjs tests/appearance/appearance-smoke.cjs",
    "test:translation": "node scripts/run-electron-test.cjs tests/translation/translation-smoke.cjs",
    "benchmark:translation": "npm run build && node scripts/translation-benchmark.cjs",
    "test:panel": "node scripts/run-electron-test.cjs tests/appearance/appearance-panel-smoke.cjs",
    "test:map": "node scripts/run-electron-test.cjs tests/map/campaign-map-smoke.cjs",
    "test:commands": "node scripts/run-electron-test.cjs tests/commands/message-commands-smoke.cjs",
    "test:music": "node scripts/run-electron-test.cjs tests/music/music-smoke.cjs",
    "test:instructions": "node scripts/run-electron-test.cjs tests/commands/host-instructions-smoke.cjs",
    "prepare:translator:windows": "node scripts/prepare-windows-translator.cjs",
    "test:bundled-model": "node tests/translation/bundled-model-smoke.cjs",
    "install:electron": "install-electron"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/node": "26.6.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "desktopName": "friends-and-fables-desktop.desktop"
}

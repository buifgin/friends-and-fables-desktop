{
  "name": "friends-and-fables-desktop",
  "productName": "Friends & Fables Desktop",
  "version": "0.2.1",
  "description": "Unofficial Friends & Fables desktop wrapper for Windows and Arch Linux",
  "private": true,
  "main": "dist/main.js",
  "author": "buifgin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buifgin/friends-and-fables-desktop.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:appearance && npm run test:translation && npm run test:panel",
    "prestart": "npm run build",
    "start": "electron-forge start",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "premake": "npm run build",
    "make": "electron-forge make",
    "dist:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux AppImage --x64 --publish never",
    "dist:windows": "npm run build && electron-builder --config electron-builder.config.cjs --win portable --x64 --publish never",
    "checksums": "node scripts/release-checksums.cjs",
    "test:unit": "node --test tests/translation-core.test.cjs",
    "test:appearance": "electron tests/appearance-smoke.cjs",
    "test:translation": "electron tests/translation-smoke.cjs",
    "benchmark:translation": "npm run build && node scripts/translation-benchmark.cjs",
    "test:panel": "electron tests/appearance-panel-smoke.cjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "26.6.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "desktopName": "friends-and-fables-desktop.desktop"
}
